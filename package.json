{
  "name": "nota",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Nota — a personal voice notebook and persistent assistant",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"tsx watch src/server/worker.ts\" \"vite\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "worker": "node --env-file-if-exists=.env dist/server/worker.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "memory:reclassify": "tsx scripts/memory-reclassify.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "test:agenda": "tsx tests/agenda-integration.ts",
    "test:agenda:live": "tsx tests/agenda-live.ts",
    "test:steering": "tsx tests/steering-integration.ts",
    "test:recordings": "tsx tests/recording-integration.ts",
    "test:action-candidates": "tsx tests/action-candidates-integration.ts",
    "test:memory": "tsx tests/memory-integration.ts",
    "test:memory:semantic": "tsx tests/memory-semantic-integration.ts",
    "test:memory:generic:live": "tsx tests/memory-generic-live.ts",
    "test:memory:live": "tsx tests/memory-generic-live.ts",
    "test:memory:legacy:live": "tsx tests/memory-live.ts",
    "test:memory:conversation:live": "tsx tests/memory-conversation-live.ts",
    "test:context": "tsx tests/context-integration.ts",
    "test:conversation": "tsx tests/conversation-integration.ts",
    "test:notifications": "tsx tests/notifications-integration.ts",
    "test:background": "tsx tests/background-integration.ts",
    "test:tasks": "tsx tests/tasks-integration.ts",
    "test:recordings:live": "tsx tests/recording-live.ts",
    "test:live": "tsx tests/live.ts",
    "test:web:live": "tsx tests/web-search-live.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.json *.ts compose*.yaml",
    "format:check": "prettier --check src scripts tests *.json *.ts compose*.yaml",
    "setup": "node scripts/setup.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:agenda && pnpm test:steering && pnpm test:recordings && pnpm test:action-candidates && pnpm test:memory && pnpm test:memory:semantic && pnpm test:context && pnpm test:conversation && pnpm test:notifications && pnpm test:background && pnpm test:tasks && pnpm build"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "cron-parser": "5.10.3",
    "fastify": "5.12.8",
    "lucide-react": "1.70.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "prettier": "3.9.10"
  }
}
