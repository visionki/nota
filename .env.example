# Run node scripts/setup.mjs to generate private secrets in .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3031
APP_URL=http://localhost:8088
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8448
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://nota:CHANGE_ME@127.0.0.1:54330/nota
COOKIE_SECRET=CHANGE_ME
DATA_DIR=.data
ALLOW_REGISTRATION=true

GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
GMI_API_KEY=
# Source: official model config + GMI model page. This is capacity, not cumulative use.
LLM_CONTEXT_WINDOW=1048576
LLM_MAX_OUTPUT_TOKENS=8192
LLM_COMPACT_RATIO=0.85
LLM_REQUEST_IDLE_MS=45000

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
TAVILY_API_KEY=
TAVILY_TIMEOUT_MS=20000
ASR_MODEL=gpt-transcribe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=24
MAX_AUDIO_SECONDS=600
FREE_DAILY_LIMIT=10
WORKER_CONCURRENCY=3
BACKGROUND_WORKER_CONCURRENCY=2
BACKGROUND_MAX_TURNS=16
FILE_WORKER_CONCURRENCY=2
RECORDING_WINDOW_IDLE_MS=1500
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_ENABLED=true
MAX_RUN_SECONDS=480

# demo never charges money; webhook requires a real merchant integration.
BILLING_MODE=demo
PAYMENT_WEBHOOK_SECRET=
